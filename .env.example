# Copy to .env.local (never commit the result).

# --- General ------------------------------------------------------------------
ENVIRONMENT=local
PROJECT_NAME=ecommerce-admin

# --- AWS / LocalStack -----------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Ports (only used by scripts/health-check.sh to check backend/frontend,
# which this repo does not start itself — see their own repos) --------------
BACKEND_PORT=4000
FRONTEND_PORT=3000

# --- LocalStack ---------------------------------------------------------------
LOCALSTACK_SERVICES=dynamodb,s3,cloudformation,iam,ssm,sts
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0
