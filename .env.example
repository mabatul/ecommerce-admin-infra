# Copy to .env.local (never commit the result).

# --- General ------------------------------------------------------------------
ENVIRONMENT=local
PROJECT_NAME=ecommerce-admin

# --- Paths to the other repos (if not cloned as siblings of this one) -------
# BACKEND_PATH=../ecommerce-admin-backend
# FRONTEND_PATH=../ecommerce-admin-frontend

# --- AWS / LocalStack -----------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Ports and the backend's public URL --------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- LocalStack ---------------------------------------------------------------
LOCALSTACK_SERVICES=dynamodb,s3,cloudformation,iam,ssm,sts
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0
